<?xml version="1.0" encoding="utf-8"?>
<!-- REQ: booking list/form/search, state actions, required-reason dialog,
     resource-filterable schedule, and chatter. Odoo built-in views/actions;
     custom XML layout and model methods. -->
     
<odoo>
    <data>

        <!-- Booking List View -->
        <record id="room_booking_booking_view_list" model="ir.ui.view">
            <field name="name">Booking List</field>
            <field name="model">room.booking.booking</field>
            <field name="arch" type="xml">
                <list>
                    <field name="booking_reference"/>
                    <field name="title"/>
                    <field name="resource_id"/>
                    <field name="user_id"/>
                    <field name="start_time"/>
                    <field name="end_time"/>
                    <field name="duration_hours"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Booking Form View -->
        <record id="room_booking_booking_view_form" model="ir.ui.view">
            <field name="name">Booking Form</field>
            <field name="model">room.booking.booking</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar" 
                               statusbar_visible="requested,confirmed,completed"
                               readonly="1"/>
                    </header>
                    <sheet>
                        <field name="can_complete" invisible="1"/>
                        <field name="can_confirm" invisible="1"/>
                        <field name="can_cancel" invisible="1"/>
                        <div class="oe_title">
                            <h1>
                                <field name="booking_reference" readonly="1"/>
                            </h1>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <button name="action_confirm" string="Confirm"
                                    type="object" class="btn btn-primary"
                                    invisible="not can_confirm"/>
                            <button name="action_complete" string="Complete"
                                    type="object" class="btn btn-primary"
                                    invisible="not can_complete"/>
                            <button name="action_cancel" string="Cancel"
                                    type="object" class="btn btn-secondary"
                                    invisible="not can_cancel"/>
                        </div>
                        
                        <group>
                            <group string="Booking Details">
                                <field name="title" placeholder="What is this booking for?"/>
                                <field name="user_id" readonly="1"/>
                                <field name="resource_id"/>
                            </group>
                            <group string="Time Information">
                                <field name="start_time"/>
                                <field name="end_time"/>
                                <field name="duration_hours" readonly="1"/>
                                <field name="reminder_sent" readonly="1"/>
                                <field name="reminder_sent_at" readonly="1"
                                       invisible="not reminder_sent"/>
                                <div class="alert alert-danger" role="alert"
                                     invisible="not validation_message">
                                    <field name="validation_message" nolabel="1" readonly="1"/>
                                </div>
                            </group>
                        </group>
                        
                        <group>
                            <field name="description" placeholder="Additional details..."/>
                        </group>
                        
                        <group>
                            <field name="notes" placeholder="Internal notes..."/>
                        </group>

                        <group invisible="state != 'cancelled'">
                            <field name="cancellation_reason"/>
                        </group>
                    </sheet>
                    
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="room_booking_cancel_wizard_view_form" model="ir.ui.view">
            <field name="name">room.booking.cancel.wizard.form</field>
            <field name="model">room.booking.cancel.wizard</field>
            <field name="arch" type="xml">
                <form string="Cancel Booking">
                    <group>
                        <field name="booking_id"/>
                        <field name="reason"
                               placeholder="Please explain why this booking is being cancelled..."/>
                    </group>
                    <footer>
                        <button name="action_confirm_cancel" string="Confirm Cancellation"
                                type="object" class="btn-primary"/>
                        <button string="Keep Booking" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Booking Search View -->
        <record id="room_booking_booking_view_search" model="ir.ui.view">
            <field name="name">Booking Search</field>
            <field name="model">room.booking.booking</field>
            <field name="arch" type="xml">
                <search>
                    <field name="booking_reference"/>
                    <field name="title"/>
                    <field name="resource_id"/>
                    <field name="user_id"/>
                    <field name="state"/>
                    <separator/>
                    <filter name="filter_requested" string="Requested" 
                            domain="[('state', '=', 'requested')]"/>
                    <filter name="filter_confirmed" string="Confirmed" 
                            domain="[('state', '=', 'confirmed')]"/>
                    <filter name="filter_completed" string="Completed" 
                            domain="[('state', '=', 'completed')]"/>
                    <filter name="filter_cancelled" string="Cancelled" 
                            domain="[('state', '=', 'cancelled')]"/>
                </search>
            </field>
        </record>

        <!-- Booking Action -->
        <record id="room_booking_booking_action" model="ir.actions.act_window">
            <field name="name">Bookings</field>
            <field name="res_model">room.booking.booking</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="room_booking_booking_view_search"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new booking.
                </p>
            </field>
        </record>

        <record id="room_booking_schedule_view_calendar" model="ir.ui.view">
            <field name="name">room.booking.booking.calendar</field>
            <field name="model">room.booking.booking</field>
            <field name="arch" type="xml">
                <calendar string="Booking Schedule"
                          date_start="start_time"
                          date_stop="end_time"
                          create_name_field="title"
                          color="calendar_color"
                          mode="week"
                          quick_create="0"
                          event_open_popup="1">
                    <field name="resource_id" filters="1"/>
                    <field name="state"/>
                    <field name="user_id"/>
                </calendar>
            </field>
        </record>

        <record id="room_booking_schedule_action" model="ir.actions.act_window">
            <field name="name">Schedule</field>
            <field name="res_model">room.booking.booking</field>
            <field name="view_mode">calendar,list,form</field>
            <field name="view_id" ref="room_booking_schedule_view_calendar"/>
            <field name="domain">[('state', '!=', 'cancelled')]</field>
        </record>

        <!-- Menu Item for Bookings -->
        <menuitem id="room_booking_menu_bookings" parent="room_booking_menu_root" 
                  name="Bookings" action="room_booking_booking_action" sequence="2"/>
        <menuitem id="room_booking_menu_schedule" parent="room_booking_menu_root"
                  name="Schedule" action="room_booking_schedule_action" sequence="3"/>

    </data>
</odoo>
