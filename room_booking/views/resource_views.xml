<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Resource List View -->
        <record id="room_booking_resource_view_list" model="ir.ui.view">
            <field name="name">Resource List</field>
            <field name="model">room.booking.resource</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="resource_type"/>
                    <field name="capacity"/>
                    <field name="availability_start"/>
                    <field name="availability_end"/>
                    <field name="is_available"/>
                </tree>
            </field>
        </record>

        <!-- Resource Form View -->
        <record id="room_booking_resource_view_form" model="ir.ui.view">
            <field name="name">Resource Form</field>
            <field name="model">room.booking.resource</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Resource Name"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group string="Basic Information">
                                <field name="resource_type"/>
                                <field name="capacity"/>
                                <field name="is_available"/>
                            </group>
                            <group string="Availability Window">
                                <field name="availability_start" widget="float_time"/>
                                <field name="availability_end" widget="float_time"/>
                            </group>
                        </group>
                        
                        <group>
                            <field name="description" placeholder="Enter resource details..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Resource Action -->
        <record id="room_booking_resource_action" model="ir.actions.act_window">
            <field name="name">Resources</field>
            <field name="res_model">room.booking.resource</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new resource (room or equipment).
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="room_booking_menu_root" name="Room Booking" sequence="1"/>
        <menuitem id="room_booking_menu_resources" parent="room_booking_menu_root" 
                  name="Resources" action="room_booking_resource_action" sequence="1"/>

    </data>
</odoo>
