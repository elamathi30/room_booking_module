<?xml version="1.0" encoding="utf-8"?>
<!-- EXTRA: run the custom reminder method every five minutes using Odoo's
     built-in ir.cron scheduler. -->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_send_booking_reminders" model="ir.cron">
            <field name="name">Room Booking: Send Upcoming Reminders</field>
            <field name="model_id" ref="model_room_booking_booking"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_booking_reminders()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
