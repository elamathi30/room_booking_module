<?xml version="1.0" encoding="utf-8"?>
<!-- Extra feature :Scheduled job that sends the one-hour booking reminders.
     Every 5 minutes Odoo calls _cron_send_booking_reminders() in booking.py,
     which finds confirmed bookings starting within the next hour that haven't
     been reminded yet. The interval only sets how often it looks, and a flag on
     each booking stops the same reminder going out twice.
    -->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_send_booking_reminders" model="ir.cron">
            <field name="name">Room Booking: Send Upcoming Reminders</field>
            <field name="model_id" ref="model_room_booking_booking"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_booking_reminders()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
