<?xml version="1.0" encoding="utf-8"?>

     <!-- Extra feature: The email sent as a reminder about an hour before a confirmed booking starts.
     The reminder cron job in booking.py picks the booking and sends this template,
     so the wording lives here instead of in Python.
     It only goes to users whose Odoo notification setting is "Handle in Odoo".
     Users set to email already get Odoo's own activity email, so skipping them
     avoids sending two. Times are shown in the booker's timezone. -->
     
<odoo>
    <data noupdate="1">
        <record id="mail_template_booking_reminder" model="mail.template">
            <field name="name">Room Booking: Upcoming Booking Reminder</field>
            <field name="model_id" ref="model_room_booking_booking"/>
            <field name="subject">Reminder: {{ object.title }} starts soon</field>
            <field name="email_to">{{ object.user_id.email_formatted or object.user_id.email }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.user_id.name"/>,</p>
                    <p>This is a reminder that your room booking starts in about one hour.</p>
                    <ul>
                        <li><strong>Booking:</strong> <t t-out="object.title"/></li>
                        <li><strong>Reference:</strong> <t t-out="object.booking_reference"/></li>
                        <li><strong>Room:</strong> <t t-out="object.resource_id.name"/></li>
                        <li>
                            <strong>Start:</strong>
                            <t t-out="format_datetime(object.start_time, tz=object.user_id.tz, dt_format='short')"/>
                        </li>
                        <li>
                            <strong>End:</strong>
                            <t t-out="format_datetime(object.end_time, tz=object.user_id.tz, dt_format='short')"/>
                        </li>
                    </ul>
                    <p>Please contact the booking organizer if these details need to change.</p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>
