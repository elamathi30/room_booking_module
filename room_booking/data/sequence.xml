<?xml version="1.0" encoding="utf-8"?>
<!-- Creates the counter that gives every booking its reference: BK/00001,
     BK/00002 and so on via Odoo's built-in ir.sequence service.
      booking.py asks for the next number when a booking is
     created, using the code below, so that code has to match the one in
     create() exactly. Numbers can skip if a save fails after one is taken,
     which is normal for sequences and harmless here. -->

<odoo noupdate="1">
    <record id="seq_room_booking" model="ir.sequence">
        <field name="name">Room Booking</field>
        <field name="code">room.booking.booking</field>
        <field name="prefix">BK/</field>
        <field name="padding">5</field>
    </record>
</odoo>
